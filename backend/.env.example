# Runtime adapters require these values when their features are used.
OPENAI_API_KEY=<SECRET>
OPENAI_VISION_MODEL=gpt-5.6-luna
TMAP_APP_KEY=tmap-demo-app-key
DATABASE_URL=postgresql+psycopg://neon_user:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Direct database access is optional and reserved for schema administration.
DATABASE_URL_DIRECT=postgresql+psycopg://neon_user:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# The application can start with these safe local defaults.
APP_ENV=local
CORS_ALLOW_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
LOCATION_OFF_ROUTE_METERS=30
LOCATION_WRONG_WAY_DEGREES=120
LOCATION_EVENT_COOLDOWN_SECONDS=30
MISSION_JOIN_CODE_TTL_MINUTES=180
